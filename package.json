{
    "name": "feedly-saved-opener",
    "version": "2.1.2",
    "description": "Open saved Feedly articles in batches, in Firefox, Edge, Chrome and Safari",
    "scripts": {
        "test": "node --test 'tests/**/*.test.js'",
        "test:coverage": "node --test --experimental-test-coverage 'tests/**/*.test.js'",
        "build": "./build-extension.sh",
        "build:safari": "./build-safari.sh",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "web-ext run --source-dir build/firefox",
        "start:chromium": "web-ext run --source-dir build/chromium --target chromium",
        "prepare": "husky install",
        "release": "release-it",
        "lint:ext": "web-ext lint --source-dir build/firefox --warnings-as-errors"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mbologna/feedly-saved-opener.git"
    },
    "keywords": [
        "feedly",
        "rss",
        "firefox-extension",
        "chrome-extension",
        "edge-extension",
        "safari-extension",
        "productivity"
    ],
    "author": "Michele Bologna",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/mbologna/feedly-saved-opener/issues"
    },
    "homepage": "https://github.com/mbologna/feedly-saved-opener#readme",
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@eslint/js": "^10.0.0",
        "@release-it/conventional-changelog": "^12.0.2",
        "esbuild": "^0.28.2",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "release-it": "^21.1.1",
        "web-ext": "^10.8.0"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix"
        ]
    },
    "release-it": {
        "npm": {
            "publish": false
        },
        "hooks": {
            "after:bump": "node -e \"const fs=require('fs');fs.writeFileSync('manifest.json',fs.readFileSync('manifest.json','utf8').replace(/\\\"version\\\": *\\\"[^\\\"]*\\\"/,'\\\"version\\\": \\\"${version}\\\"'))\""
        },
        "git": {
            "commitMessage": "chore: release v${version}",
            "tagName": "v${version}"
        },
        "github": {
            "release": false
        },
        "plugins": {
            "@release-it/conventional-changelog": {
                "preset": {
                    "name": "angular"
                }
            }
        }
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    }
}
